{
    "plugins": [
        //latex用プラグインを有効化 これは絶対必要
        "latex2e"
    ],
  "rules": {
    "preset-ja-engineering-paper": false,
    "preset-ja-spacing": true,
    "preset-ja-technical-writing": {
      "ja-no-mixed-period": {
        "periodMark": "。"
      },
    },
    "preset-japanese": true,
    "preset-jtf-style": {
      "1.2.1.句点(。)と読点(、)": false,
      "1.2.2.ピリオド(.)とカンマ(,)": false,
      "4.1.3.ピリオド(.)、カンマ(,)": false,
      "4.3.1.丸かっこ（）":false,
      "4.2.2.疑問符(？)":true.
      "4.3.2.大かっこ［］": false
    },
  },
}