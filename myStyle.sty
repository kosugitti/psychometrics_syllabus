% ソースコード用のパッケージと設定
\usepackage{colortbl,xcolor}
\usepackage{listingsutf8}
\renewcommand{\lstlistingname}{code :}
% ソースコードのフォントを変えたい
\lstset{
    frame=single,
    backgroundcolor={\color[gray]{.95}},
    keywordstyle={\color{magenta}},
    stringstyle=\color{blue}, 
    basicstyle=\ttfamily\small,
    numberstyle={\ttfamily\small\color{black}},  
    commentstyle = {\ttfamily \color[cmyk]{1,0.4,1,0}},
    numbers=left,
    numbersep=10pt,
    tabsize=2,
    extendedchars=true,
    xleftmargin=17pt,
    framexleftmargin=17pt
}
% Hyper Linkを目立たせない呪文
\hypersetup{
setpagesize=false,
 bookmarksnumbered=true,%
 bookmarksopen=true,%
 colorlinks=true,%
 linkcolor=blue,
 citecolor=teal,
 urlcolor=magenta
}

% 強調表現/索引
\newcommand\keyterm[3]{\textbf{#1(#3)}\index{#2@#1}}
\newcommand\keytermL[2]{\textbf{#1}\index{#2@#1}}

% 枠囲いのパッケージ
\usepackage{tcolorbox}
\tcbuselibrary{breakable, skins, theorems}
\tcbuselibrary{theorems}
% スクリーン出力
\newtcbtheorem[number within=chapter]{Rscreen}{Rの出力}{fonttitle=\gtfamily\sffamily\bfseries\upshape,colframe=gray,colback=blue!3!,fontupper=\gtfamily\small}{RS}
\newtcbtheorem{SCrstan}{rstanの出力}{fonttitle=\gtfamily\sffamily\bfseries\upshape,colframe=gray,colback=green!3!,fontupper=\gtfamily\small}{SCrstan}
\newtcbtheorem{SCcmd}{cmdstanrの出力}{fonttitle=\gtfamily\sffamily\bfseries\upshape,colframe=gray,colback=pink!3!,fontupper=\gtfamily\small}{SCcmd}
% コラム
\newtcbtheorem{Untiku}{うんちく}{fonttitle=\gtfamily\sffamily\bfseries,colframe=blue,colback=blue!7!,fontupper=\gtfamily\small}{Untiku}

% FAQ box
\newtcbtheorem[number within=section]{FAQ}{Q.}
{
    fonttitle=\gtfamily\sffamily,
    skin=bicolor,
    colframe=gray!2,
    colback=gray!10!white,
    rightrule=10pt,
    leftrule=10pt,
    bottomrule=2pt,
    colbacktitle=red!65,
    theorem style=standard,
    arc=3pt,
    colbacklower=green!5
}{FAQbox}


