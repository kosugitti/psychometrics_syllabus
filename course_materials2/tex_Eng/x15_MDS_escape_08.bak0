\begin{lstlisting}[language=C++,label={code:x15_02},caption={距離行列の計算}]
dat <- read_csv("M1score2021.csv")
dat.mat <- dat %>%
  dplyr::filter(年代 == 21) %>%
  arrange(ネタ順) %>% 
  dplyr::select(-年代, -ネタ順) %>%
  pivot_longer(-演者) %>%
  na.omit() %>%
  pivot_wider(id_cols = 演者, 
  			  names_from = name,
			  values_from = value) %>%
  as.matrix()
rownames(dat.mat) <- dat.mat[, 1]
dat.mat <- dat.mat[, -1] %>%
  dist()
\end{lstlisting}
