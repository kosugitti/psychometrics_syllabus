\begin{lstlisting}[language=C++,label={stan::21_06},caption={整然データに対応したコード}]
data{
  int<lower=0> Lv;                             // 水準数
  int<lower=0> L;                              // データ数
  array[L] int<lower=0,upper=Lv> idx;          // データのID
  array[L] real X;                             // 変数の値
}
...(中略)...
model{
  // Likelihood
  for(l in 1:L){
    X[l] ~ normal(mu[idx[l]],sig);
  }
    
  // Prior
  gm ~ uniform(0,100);
  raw_effect ~ uniform(-100,100);
  sig ~ uniform(0,100000);
}
\end{lstlisting}
