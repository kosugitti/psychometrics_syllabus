\begin{lstlisting}[language=C++,label={code:PRE_05MCMC2dfRSTAN},caption={MCMCtoDF関数(rstan版)}]
MCMCtoDF <- function(fit) {
  fit %>%
    rstan::extract() %>%
    as.data.frame() %>%
    tibble::as_tibble() %>%
    tibble::rowid_to_column("iter") %>%
    dplyr::select(-lp__) %>%
    tidyr::pivot_longer(-iter) -> MCMCsample
  return(MCMCsample)
}
\end{lstlisting}
