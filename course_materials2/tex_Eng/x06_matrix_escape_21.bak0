\begin{equation*}
    \begin{pmatrix}
        1 & 3
    \end{pmatrix}
    \begin{pmatrix}
        1 & 0 \\
        2 & 3
    \end{pmatrix}
    =
    \begin{pmatrix}
        1 \times 1 + 2 \times 3 & 1\times 0+3 \times 3
    \end{pmatrix}
    =
    \begin{pmatrix}
        7 & 9
    \end{pmatrix}
\end{equation*}
