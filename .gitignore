*.aux
*.out
*.toc
*.idx
*.ilg
*.ind
*.synctex.gz
*.fls
*.fdb_latexmk
*.bcf
*.run.xml
*.blg
*.bbl

# Ignore .old files except in contents_basic
*.old
!Psychometrics/contents_basic/*.old

# Ignore most .log files except important ones
*.log
!BasicBook3.log
!Psychometrics/contents_basic/error.log

