\@writefile{lof}{\contentsline {figure}{\numberline {17.5}{\ignorespaces 標本統計量の従う分布も正規分布。幅は母分散とサンプルサイズに依存します。}}{191}{figure.17.5}\protected@file@percent }
\newlabel{fig::17_03}{{17.5}{191}{標本統計量の従う分布も正規分布。幅は母分散とサンプルサイズに依存します。}{figure.17.5}{}}
