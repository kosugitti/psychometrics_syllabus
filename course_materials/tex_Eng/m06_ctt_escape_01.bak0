\begin{align*}
     & \bar{X_i}  =  \frac{1}{M}\sum_{j=1}^M X_{ij}                    \\
     & =  \frac{1}{M}\sum_{j=1}^M (t_i + e_{ij})                       \\
     & =  \frac{1}{M}\sum_{j=1}^M t_i + \frac{1}{M}\sum_{j=1}^M e_{ij} \\
     & =  t_i + \bar{e_{i}}                                            \\
\end{align*}
