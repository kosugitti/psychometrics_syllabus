\begin{table}[ht]
    \caption{Rules regarding probability in R}
    \centering
    \begin{tabular}{lll}
        Usage & Function Name for Code \texttt{XXX} & Explanation \\\hline
        Probability density & dxxx(q) & q represents a probability point. If the code name is norm, then it becomes dnorm(q) \\
        Cumulative probability & pxxx(q) & q represents a probability point. If the code name is norm, then it becomes pnorm(q) \\
        Probability point & qxxx(p) & p represents a probability. If the code name is norm, then it becomes qnorm(p) \\
        Random number & rxxx(n) & n represents the number of random numbers. If the code name is norm, then it becomes rnorm(n) \\\hline
    \end{tabular}
    \label{tbl::08_02}
\end{table}
