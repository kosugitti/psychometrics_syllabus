\newlabel{ex::SampleMean}{{13.1}{135}{標本平均の区間推定}{equation.13.1.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13.1}{\ignorespaces 推測統計学の枠組みで考えることに注意。以前(セクション\ref  {sec::6c})は上の図のように，推測するのではなくて母集団そのものの中に一個人のスコアを位置付けて，相対的な位置を考えよう，という話でした。今回は下のように，母集団が正規分布だと仮定して，そこから得られた標本のことについて考えています。個々のデータは標本の中にあります。また今回考えるのは標本統計量で，それが標本分布に従うのでした。}}{136}{figure.13.1}\protected@file@percent }
\newlabel{fig::17_01}{{13.1}{136}{推測統計学の枠組みで考えることに注意。以前(セクション\ref {sec::6c})は上の図のように，推測するのではなくて母集団そのものの中に一個人のスコアを位置付けて，相対的な位置を考えよう，という話でした。今回は下のように，母集団が正規分布だと仮定して，そこから得られた標本のことについて考えています。個々のデータは標本の中にあります。また今回考えるのは標本統計量で，それが標本分布に従うのでした。}{figure.13.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13.2}{\ignorespaces 標本統計量の従う分布も正規分布。幅は母分散とサンプルサイズに依存します。}}{137}{figure.13.2}\protected@file@percent }
\newlabel{fig::17_02}{{13.2}{137}{標本統計量の従う分布も正規分布。幅は母分散とサンプルサイズに依存します。}{figure.13.2}{}}
